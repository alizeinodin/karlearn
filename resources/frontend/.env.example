# Empty basename when Laravel serves the SPA at domain root.
# For a subpath deploy (e.g. https://example.com/karlearn) set:
# REACT_APP_BASENAME=/karlearn
# REACT_APP_API_BASE=/karlearn/api
# REACT_APP_ASSET_BASE=/karlearn
# PUBLIC_URL=/karlearn/frontend
# homepage in package.json should match PUBLIC_URL

REACT_APP_BASENAME=
REACT_APP_API_BASE=/api
REACT_APP_ASSET_BASE=
PUBLIC_URL=/frontend
